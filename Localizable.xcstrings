    },
    "A journey that takes you from the tales of travelers and the stillness of the sands to exploring the secrets of desert plants and collecting their treasures." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رحلةٌ تأخذك من حكاياتِ الرُّحَّل\nمع سكونِ الرمالِ وهمسِها العتيق،\nإلى اكتشافِ أسرارِ نباتاتِ الصحراء،\nوجمعِ كنوزِها المخبوءة بين ذراتِ الرمل "
          }
        }
      }
    },
    "A mark that remains, and a proof that you have arrived" : {
      "comment" : "A text displayed below the main text in the end view, describing the significance of the user's actions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثرٌ يبقى، ودليلٌ على وصولك"
          }
        }
      }
    },
    "Aromatic" : {
      "comment" : "Special feature of the Eve Tree.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
