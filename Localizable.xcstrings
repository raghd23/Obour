    "Complete more journeys to collect items." : {
      "comment" : "A description below the image in the empty collection view, encouraging the user to complete more journeys to collect items.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اكمالك المراحل، ستحصل على كل العناصر "
          }
        }
      }
    },
    "Continue" : {
      "comment" : "A button that, when pressed, continues the story after the narration completes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
