    "Samh plant" : {
      "comment" : "Name of the Samh plant.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شجرة السمح"
          }
        }
      }
    },
    "Samh plant is Rare to find\nIt is a desert shrub that grows in harsh conditions. \nIn times of drought, its seeds were food for the Bedouins, who collected them one by one from the sand. \nThis plant carries within it the history of the people who lived on this land before you." : {
      "comment" : "Name of the Samh plant.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نادرة الوجود.\nنبتة صحراوية تنمو في البيئات القاسية. \nفي سنوات القحط، كانت بذورها طعامًا للبدو، يجمعونها حبةً حبة من الرمل. \nتحمل هذه النبتة في داخلها تاريخ الّذين عاشوا في هذه الأرض قبلك."
          }
        }
      }
    },
