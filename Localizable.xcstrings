      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل عنصرٍ التقطته يحمل قصةً صغيرة منك، وأصبحت العناصر التي جمعتها شاهدًا على عبورك…"
